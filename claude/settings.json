{
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null || PATH=\"$PATH:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin\"; command -v bun >/dev/null || exit 0; in=$(cat); printf '%s' \"$in\" | bun \"$HOME/.dotfiles/claude/hooks/organize-ts-imports.ts\" 2>/dev/null; printf '%s' \"$in\" | bun \"$HOME/.dotfiles/claude/hooks/format-on-edit.ts\" 2>/dev/null; exit 0",
            "timeout": 30,
            "statusMessage": "Organizing imports & formatting"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": false,
  "useAutoModeDuringPlan": true
}
